#!/usr/bin/env bash
# Complete SDK wheel/sdist preparation. Explicit --upload publishes tested artifacts.
_jhsrel_SRC="$0"
if [[ -n "${BASH_VERSION:-}" ]]; then
  _jhsrel_SRC="${BASH_SOURCE[0]}"
elif [[ -n "${ZSH_VERSION:-}" ]]; then
  _jhsrel_SRC="$(eval 'echo ${(%):-%x}')"
fi
_jhsrel_DIR="$(cd "$(dirname "$_jhsrel_SRC")" && pwd)"
jhsrel() { bash "$_jhsrel_DIR/scripts/full-release.sh" "$@"; }
_jhsrel_sourced=0
if [[ -n "${BASH_VERSION:-}" ]]; then
  [[ "${BASH_SOURCE[0]}" != "$0" ]] && _jhsrel_sourced=1
elif [[ -n "${ZSH_VERSION:-}" ]]; then
  case "${ZSH_EVAL_CONTEXT:-}" in *:file) _jhsrel_sourced=1 ;; esac
fi
if [[ "$_jhsrel_sourced" -eq 0 ]]; then
  jhsrel "$@"
fi
